# ------------------------------------------------------------------------------------ TASKS -------
[tasks]
--pycode-begin--
for name in [ # -------------- List all components to PROVE --------------------
    'rle_decode',
    'rle_encode'
    ]:
    output(f"{name}_prove prove name_tag_{name}")

for name in [ # -------------- List all components for BMC ---------------------
    'rle_decode',
    'rle_encode'
    ]:
    output(f"{name}_bmc bmc name_tag_{name}")

for name in [ # -------------- List all components to COVER --------------------
    'rle_decode',
    'rle_encode'
    ]:
    output(f"{name}_cover cover name_tag_{name}")
--pycode-end--

# ----------------------------------------------------------------------------------- OPTIONS ------
[options]
depth 20
prove: mode prove
bmc: mode bmc
cover: mode cover


# ----------------------------------------------------------------------------------- ENGINES ------
[engines]
bmc: smtbmc
cover: smtbmc
prove: abc pdr

# ------------------------------------------------------------------------------------ SCRIPT ------
[script]
--pycode-begin--
for tag in tags:
    # Generates build scripts for all unique component names
    if tag.startswith('name_tag_'):
        name = tag.split('name_tag_')[-1]
        add_files = 'utils.vhdl skid_buffer.vhdl'

        output(f"{tag}: ghdl --std=08 --work=colibri {add_files} {name}.vhdl {name}.psl -e {name}")
        output(f"{tag}: prep -top {name}")
--pycode-end--

# ------------------------------------------------------------------------------------ FILES -------
[files]
../../src/common/utils.vhdl
../../src/common/skid_buffer.vhdl

--pycode-begin--
for tag in tags:
    # Includes source files for all unique component names
    if tag.startswith('name_tag_'):
        name = tag.split('name_tag_')[-1]
        
        output(f"../../src/endec/{name}.vhdl")
        output(f"{name}.psl")
--pycode-end--

