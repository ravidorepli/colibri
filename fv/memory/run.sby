# ------------------------------------------------------------------------------------ TASKS -------
[tasks]
--pycode-begin--
for name in [ # -------------- List all components to PROVE --------------------
    'fifo',
    'ring_buffer'
    ]:
    output(f"{name}_prove prove name_tag_{name}")

for name in [ # -------------- List all components for BMC ---------------------
    'fifo',
    'ring_buffer'
    ]:
    output(f"{name}_bmc bmc name_tag_{name}")

for name in [ # -------------- List all components to COVER --------------------
    'fifo',
    'ring_buffer'
    ]:
    output(f"{name}_cover cover name_tag_{name}")
--pycode-end--

# ----------------------------------------------------------------------------------- OPTIONS ------
[options]
prove: mode prove
bmc: mode bmc
bmc: depth 20
cover: mode cover
cover: depth 20

# ----------------------------------------------------------------------------------- ENGINES ------
[engines]
cover: smtbmc
bmc: abc bmc3
prove: abc pdr

# ------------------------------------------------------------------------------------ SCRIPT ------
[script]
--pycode-begin--
for tag in tags:
    # Generates build scripts for all unique component names
    if tag.startswith('name_tag_'):
        name = tag.split('name_tag_')[-1]

        add_files = 'utils.vhdl types.vhdl gearbox.vhdl'

        output(f"{tag}: ghdl --std=08 --work=colibri -frelaxed {add_files} {name}.vhdl {name}.psl -e {name}")
        output(f"{tag}: prep -top {name}")
--pycode-end--

# ------------------------------------------------------------------------------------ FILES -------
[files]
../../src/common/utils.vhdl
../../src/common/types.vhdl
../../src/comms/gearbox.vhdl

--pycode-begin--
for tag in tags:
    # Includes source files for all unique component names
    if tag.startswith('name_tag_'):
        name = tag.split('name_tag_')[-1]
        
        output(f"../../src/memory/{name}.vhdl")
        output(f"{name}.psl")
--pycode-end--

