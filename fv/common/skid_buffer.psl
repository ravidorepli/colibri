vunit skid_buffer_vu (skid_buffer(rtl)) {
    
    default clock is rising_edge(clk_i);
    attribute keep : boolean;

    assume reset_i;

    -- data does not change when pipeline stalls
    assume always (snk_valid_i = '1' and snk_ready_o = '0') |=> (snk_valid_i = '1' and snk_data_i = prev(snk_data_i));

    -- data is not valid in the clock after reset
    assume always reset_i |=> snk_valid_i = '0';


    -- output is not valid after reset and register is empty
    t_no_valid_after_reset: assert always reset_i |=> src_valid_o = '0' and reg_full = '0';

    -- output does not change when backpressure is applied
    t_out_stable_backpressure: assert always ((src_valid_o = '1' and src_ready_i = '0') |=> (src_valid_o = '1' and src_data_o = prev(src_data_o))) abort reset_i;

    -- no data shall be dropped
    t_no_data_drop : assert always ((snk_valid_i = '1' and snk_ready_o = '1' and src_valid_o = '1' and src_ready_i = '0') |=> (reg_full = '1' and reg_if.data = prev(snk_data_i))) abort reset_i;

    -- idle
    t_idle : assert always ((src_ready_i = '1') |=> (snk_valid_i = src_valid_o)) abort reset_i;

    -- register read
    t_reg_read : assert always (reg_full = '1' and src_ready_i = '1') |=> reg_full = '0';
}