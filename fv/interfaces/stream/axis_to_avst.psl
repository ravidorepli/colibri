vunit axis_to_avst_vu (axis_to_avst(rtl)) {
    
    default clock is rising_edge(clk_i);
    attribute keep : boolean;
    -- IMPORTANT: reset_i the DUT at start!
    assume {reset_i; not reset_i};
    assume always (not reset_i) |=> (not reset_i);

    constant c_WORD_BYTES : integer := src_data_o'length/8;
    
    -- type used for packet classification
    -- IDLE is no packet
    -- SINGLE is a single word packet
    -- MULTI is a multi word packet
    type pkt_t is (IDLE, SINGLE, MULTI);
        
    signal s_snk_pkt : pkt_t := IDLE;
    
    -- PROCESS: classifies incoming packets
    proc_snk_pkt : process (clk_i)
    begin
        if rising_edge(clk_i) then
            if reset_i = '1' then
                s_snk_pkt <= IDLE;
            else
                -- if incoming data is ready and valid
                if s_snk_pkt = SINGLE then
                    s_snk_pkt <= IDLE; -- packet is closed, return to IDLE
                end if;
                if (snk_tvalid_i = '1' and snk_tready_o = '1') then
                    -- if there is a startofpacket asserted and no endofpacket
                    if(snk_tlast_i = '0') then
                        s_snk_pkt <= MULTI; -- multi word packet
                    -- there is an endofpacket and no startofpacket
                    elsif(s_snk_pkt = MULTI and snk_tlast_i = '1') then
                        s_snk_pkt <= IDLE; -- packet is closed, return to IDLE
                    -- there is both start and end
                    elsif(snk_tlast_i = '1') then
                        s_snk_pkt <= SINGLE; -- single word packet
                    else
                        -- in the middle of a packet
                    end if;
                end if;
            end if;
        end if;
    end process;
    

    -- keep is modified only on the last word
    assume always snk_tlast_i = '0' -> (snk_tkeep_i = (snk_tkeep_i'range => '1'));

    -- keep is correctly encoded
    signal keep_oh : snk_tkeep_i'subtype;

    keep_oh <= snk_tkeep_i xor ('0' & snk_tkeep_i(snk_tkeep_i'left downto 1));
    assume always onehot(keep_oh);
    assume always snk_tkeep_i /= (snk_tkeep_i'range => '0');

    signal s_src_pkt : pkt_t := IDLE;
    -- counter for output words
    signal s_src_word_cnt : integer;
    
    --PROCESS: Classify output packets
    p_src_pkt : process (clk_i)
    begin
        if rising_edge(clk_i) then
            if reset_i = '1' then
                s_src_pkt <= IDLE;
                s_src_word_cnt <= 0;
            else
                -- if output data is ready and valid
                if (src_valid_o = '1' and src_ready_i = '1') then
                    -- if there is a startofpacket asserted and no endofpacket
                    s_src_word_cnt <= s_src_word_cnt +1;
                    if(src_sop_o = '1' and src_eop_o = '0') then
                        s_src_pkt <= MULTI; -- multi word packet
                    -- there is an endofpacket and no startofpacket
                    elsif(src_sop_o = '0' and src_eop_o = '1') then
                        s_src_pkt <= IDLE; -- packet is closed, return to IDLE
                    -- there is both start and end
                    elsif(src_sop_o = '1' and src_eop_o = '1') then
                        s_src_pkt <= SINGLE; -- single word packet
                        s_src_word_cnt <= 0;
                    else
                        -- in the middle of a packet
                    end if;
                end if;
            end if;
        end if;
    end process;
    
    -- TESTS on output packets
    -- if the out is IDLE and src is ready and valid, a sop must be present
    t_valid_out_sop : assert always (not reset_i and s_src_pkt = IDLE and src_ready_i and src_valid_o) -> (src_sop_o);
    -- if the out is a MULTI word and src is ready and valid, a sop must NOT be present
    t_valid_out_multi : assert always (not reset_i  and s_src_pkt = MULTI and src_ready_i and src_valid_o) -> (not src_sop_o);
    -- if there is sop eop ready and valid, the out must be a single packet (on the next clock)
    t_valid_out_single : assert always (not reset_i and src_ready_i and src_valid_o and src_sop_o and src_eop_o) |=> (s_src_pkt = SINGLE);
    
    -- EMPTY tests
    -- check if empty is valid
    t_empty_out : assert always (not reset_i and src_eop_o and src_ready_i and src_valid_o) -> (to_integer(src_empty_o) < c_WORD_BYTES);
    
}